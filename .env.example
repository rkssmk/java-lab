# Replace all example values. Never commit the real .env file.
DOMAIN=java-lab.example.ru
DB_NAME=javalab
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_ADMIN_PASSWORD
DB_USERNAME=javalab_app
DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD

# Safety gate: both flags stay false until the operator, documents and legal review are complete.
APP_COOKIE_SECURE=true
APP_REGISTRATION_ENABLED=false
APP_LEGAL_LAUNCH_APPROVED=false

# Fill only with the actual person/company who is the data controller.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_VERSION=2026-11-draft-1
LEGAL_CONSENT_VERSION=2026-11-draft-1
LEGAL_TERMS_VERSION=2026-11-draft-1
# SHA-256 of the final, lawyer-reviewed public/consent.html file. Empty means registration stays closed.
LEGAL_CONSENT_SHA256=

# The external Judge0 service must remain disabled. Only use an isolated runner hosted in Russia,
# after separately reviewing its data-processing role and security.
RUNNER_ENABLED=false
JUDGE0_BASE_URL=
JUDGE0_AUTH_TOKEN=

# Used only by deploy/backup.sh. Store this secret in the server's secret manager, not in Git.
BACKUP_PASSPHRASE=REPLACE_WITH_A_LONG_RANDOM_ENCRYPTION_SECRET
BACKUP_HMAC_PASSPHRASE=REPLACE_WITH_ANOTHER_LONG_RANDOM_MAC_SECRET
